.origin 0
        set pindirs, 3, 2        ; SCK, CS_n outputs (only this lane's pins)
        mov osr, ~null
        out pindirs, 1           ; MOSI output
        set pins, 3, 2
    .wrap_target
        pull block
        set pins, 1, 2       ; CS_n low
        setx 7
    bit:
        out pins, 1 [1]
        set pins, 0, 2 [1]
        in pins, 1
        set pins, 1, 2
        jmp x--, bit
        push block
        set pins, 3, 2 [1] ; CS_n high
    .wrap
