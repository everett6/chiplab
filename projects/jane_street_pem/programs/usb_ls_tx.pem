.origin 0
        set pindirs, 3, 2
        set pins, 1, 2         ; J (low speed: D- high)
    .wrap_target
        out y, 16              ; header (autopull)
        line nrzi, stuff, diff, reset
        crc init
        setx 14
    p:  out pins, 1 [3]       ; SYNC + PID, bits 0-14
        jmp x--, p
        out pins, 1 [2]   ; PID bit 15
        crc start
        mov x, y
    q:  out pins, 1 [3]       ; payload (autopull refills the OSR)
        jmp x--, q
        out pins, 1 [1]   ; last payload bit
        mov osr, ~crc
        crc off
        setx 14
    c:  out pins, 1 [3]       ; CRC16, inverted, LSB first
        jmp x--, c
        out pins, 1 [3]
        line reset
        set pins, 0, 2 [9]   ; SE0 for two bit times
        set pins, 1, 2 [4]       ; J
    .wrap
